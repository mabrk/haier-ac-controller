# SmartHQ login credentials (same ones you use in the SmartHQ app)
SMARTHQ_USERNAME=your@email.com
SMARTHQ_PASSWORD=yourpassword

# "US" or "EU" depending on where your account was registered
SMARTHQ_REGION=US

# Your AC's device ID (MAC address format).
# Leave blank first, start the server, then open /api/devices to find it.
SMARTHQ_DEVICE_ID=
