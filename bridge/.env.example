# SmartHQ login credentials (same ones you use in the SmartHQ app)
SMARTHQ_USERNAME=your@email.com
SMARTHQ_PASSWORD=yourpassword

# "US" or "EU" depending on where your account was registered
SMARTHQ_REGION=US

# Your AC's device ID (MAC address format).
# Leave blank first, start the server, then open /api/devices to find it.
SMARTHQ_DEVICE_ID=

# ── External access auth ──────────────────────────────────────────
# Only required when accessing from outside your home network.
# LAN/local requests are always allowed through without a password.
AUTH_USERNAME=admin
AUTH_PASSWORD=changeme

# Secret key for signing session cookies.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
# If left blank, a random key is used — sessions will expire on server restart.
SESSION_SECRET=

# ── Reverse proxy / HTTPS ─────────────────────────────────────────
# Set TRUSTED_PROXY to your proxy's IP when running behind Nginx or Caddy,
# so that X-Forwarded-For is used for the real client IP (not the proxy IP).
# Leave blank when this server is directly internet-facing.
TRUSTED_PROXY=

# Set to "true" when serving over HTTPS to add the Secure flag to cookies.
SECURE_COOKIES=false
